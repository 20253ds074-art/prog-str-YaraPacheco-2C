<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="534.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.practicaexamen3.controllers.Controller">
   <children>
      <GridPane prefHeight="220.0" prefWidth="519.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label text="Telefono" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <Label text="Parentezco" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
             <TextField fx:id="txtNombre" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
             <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
             <ComboBox fx:id="cmbParentesco" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
         </children>
      </GridPane>
      <Button layoutX="8.0" layoutY="220.0" mnemonicParsing="false" text="Agregar" onAction="#onAgregar" />
      <Button layoutX="78.0" layoutY="220.0" mnemonicParsing="false" text="Buscar" onAction="#onBuscar"/>
      <Button layoutX="154.0" layoutY="220.0" mnemonicParsing="false" text="Actualizar" onAction="#onActualizar"/>
      <Button layoutX="234.0" layoutY="220.0" mnemonicParsing="false" text="Eliminar" onAction="#onEliminar"/>
      <Button layoutX="306.0" layoutY="220.0" mnemonicParsing="false" text="Limpiar" onAction="#onLimpiar"/>
       <ListView fx:id="listView" layoutX="3.0" layoutY="247.0" prefHeight="186.0" prefWidth="277.0" />
       <Label fx:id="lblMsg" text="Mensajes aquí"/>
   </children>
</VBox>
